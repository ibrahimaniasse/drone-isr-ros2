<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_isr</name>
  <version>0.1.0</version>
  <description>
    ISR drone simulation — quadrotor surveillance in Gazebo Harmonic with ROS2 Jazzy.
    Demonstrates lawnmower patrol pattern, YOLOv8 nadir camera detection, and ROS2 alerting.
  </description>
  <maintainer email="dev@drone-isr.local">ISR Drone Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclpy</depend>

  <!-- Custom messages -->
  <depend>drone_isr_msgs</depend>

  <!-- Messages -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- TF -->
  <depend>tf2_ros</depend>

  <!-- Image processing -->
  <depend>cv_bridge</depend>

  <!-- Gazebo bridge & sim -->
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_sim</depend>

  <!-- RViz2 -->
  <exec_depend>rviz2</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
