        <geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
      </collision>
    </link>
  </model>

  <model name="personne_perimetre">
    <static>true</static>
    <pose>100 -20 0 0 0 0</pose>
    <link name="link">
      <visual name="corps">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
        <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
      </visual>
      <visual name="tete">
        <pose>0 0 1.85 0 0 0</pose>
        <geometry><sphere><radius>0.15</radius></sphere></geometry>
        <material><ambient>0.85 0.7 0.55 1</ambient><diffuse>0.85 0.7 0.55 1</diffuse></material>
      </visual>
      <collision name="col">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
      </collision>
    </link>
  </model>

  <!-- Drone VTOL ISR spawn au sol -->
  <include>
    <name>isr_drone</name>
    <uri>model://isr_drone</uri>
    <pose>-180 -130 0.1 0 0 0</pose>
  </include>

</world>
</sdf>
