        </material>
      </visual>
    </link>
  </model>

  <model name="building_4">
    <static>true</static>
    <pose>-15.2 -72.9 6.0 0 0 0</pose>
    <link name="link">
      <collision name="col">
        <geometry><box><size>41.0 60.1 12.0</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>41.0 60.1 12.0</size></box></geometry>
        <material>
