  <model name="building_5">
    <static>true</static>
    <pose>56.1 47.9 3.0 0 0 0</pose>
    <link name="link">
      <collision name="col">
        <geometry><box><size>37.5 57.3 6.0</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>37.5 57.3 6.0</size></box></geometry>
        <material>
