<?xml version="1.0" ?>
<sdf version="1.9">
<world name="surveillance_zone">

  <physics name="1ms" type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>



  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 100 0 0 0</pose>
    <diffuse>0.85 0.85 0.85 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>0.5 -0.5 -1</direction>
  </light>

  <light name="ambient_fill" type="directional">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 50 0 0 0</pose>
    <diffuse>0.4 0.4 0.45 1</diffuse>
    <specular>0.0 0.0 0.0 1</specular>
    <direction>-0.5 0.5 -1</direction>
  </light>

  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>1000 1000</size></plane>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <plane><normal>0 0 1</normal><size>1000 1000</size></plane>
        </geometry>
        <material>
          <ambient>0.30 0.28 0.25 1</ambient>
          <diffuse>0.38 0.35 0.30 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- Batiments OSM Port de Gennevilliers — 6 entrepots reels -->
  <model name="building_0">
    <static>true</static>
    <pose>199.0 -73.0 3.0 0 0 0</pose>
    <link name="link">
      <collision name="col">
        <geometry><box><size>85.6 124.8 6.0</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>85.6 124.8 6.0</size></box></geometry>
        <material>
          <ambient>0.60 0.58 0.52 1</ambient>
          <diffuse>0.65 0.62 0.55 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <model name="building_1">
    <static>true</static>
    <pose>109.6 60.4 4.0 0 0 0</pose>
    <link name="link">
      <collision name="col">
        <geometry><box><size>95.2 73.9 8.0</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>95.2 73.9 8.0</size></box></geometry>
        <material>
          <ambient>0.50 0.52 0.55 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <model name="building_2">
    <static>true</static>
    <pose>-48.6 -43.9 5.0 0 0 0</pose>
    <link name="link">
      <collision name="col">
        <geometry><box><size>76.2 52.7 10.0</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>76.2 52.7 10.0</size></box></geometry>
        <material>
          <ambient>0.45 0.43 0.40 1</ambient>
          <diffuse>0.50 0.48 0.44 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
