  <!-- Cibles ISR vehicules -->
  <include>
    <name>hatchback_1</name>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius%20Hybrid</uri>
    <pose>45 -30 0 0 0 0</pose>
  </include>

  <include>
    <name>suv_1</name>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
    <pose>-60 20 0 0 0 0</pose>
  </include>

  <include>
    <name>hatchback_2</name>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
    <pose>80 60 0 0 0 0</pose>
  </include>

  <!-- Cibles ISR personnes — URIs confirmes -->
  <model name="personne_quai">
    <static>true</static>
    <pose>20 -80 0 0 0 0</pose>
    <link name="link">
      <visual name="corps">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
        <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
      </visual>
      <visual name="tete">
        <pose>0 0 1.85 0 0 0</pose>
        <geometry><sphere><radius>0.15</radius></sphere></geometry>
        <material><ambient>0.85 0.7 0.55 1</ambient><diffuse>0.85 0.7 0.55 1</diffuse></material>
      </visual>
      <collision name="col">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry>
      </collision>
    </link>
  </model>

